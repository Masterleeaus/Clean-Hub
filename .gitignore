# Environment and credentials
/.env
/.env.*
!/.env.example
/auth.json
/.npmrc
/.pypirc
*.pem
id_rsa
id_dsa

# Installed dependencies
/vendor/
/node_modules/

# Generated frontend and public runtime content
/public/build/
/public/storage
/public/upload/
/public/uploads/

# Laravel runtime state
/storage/*.key
/storage/app/*
!/storage/app/public/
/storage/framework/cache/*
!/storage/framework/cache/data/
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
/bootstrap/cache/*.php

# Test and analysis output
/coverage/
*.log
.phpunit.result.cache
.phpstan.cache

# Operating-system and editor metadata
.DS_Store
.idea/
.vscode/

# Source archives and zips (large binary files)
/sources/
*.zip
!.gitkeep
/.worktrees
/storage/integration-evidence
